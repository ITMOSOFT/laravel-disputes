{
  "name": "itmosoft/laravel-disputes",
  "description": "Dispute management workflows for Laravel applications, with polymorphic parties and subjects, evidence metadata, reviewer assignment, and resolution tracking.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.5|^12.0"
  },
  "autoload": {
    "psr-4": {
      "ITMOSOFT\\Disputes\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ITMOSOFT\\Disputes\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ITMOSOFT\\Disputes\\DisputesServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
